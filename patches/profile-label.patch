+  // Camoufox: Update profile label in Identity Box
+  _updateCamoufoxProfileLabel() {
+    let profileName = ChromeUtils.camouGetString("browser.profileName");
+    if (!profileName) return;
+
+    let identityBox = this.document.getElementById("identity-box");
+    if (!identityBox) return;
+
+    let label = this.document.getElementById("camoufox-profile-label");
+    if (!label) {
+      label = this.document.createXULElement("label");
+      label.id = "camoufox-profile-label";
+      label.style.fontWeight = "bold";
+      label.style.color = "var(--toolbar-field-color, inherit)";
+      label.style.marginInline = "6px";
+      label.style.display = "flex";
+      label.style.alignItems = "center";
+      label.style.opacity = "0.7";
+      identityBox.appendChild(label);
+    }
+    label.setAttribute("value", "[" + profileName + "]");
+  }
